# Keys to create in Infisical (project env: prod, path: /). Values here are examples only.
# Generate random secrets with: openssl rand -hex 32   (use hex: special characters break the AMQP URL)

# Domain
APP_DOMAIN=vynk.robustcraft.com
WEB_URL=https://vynk.robustcraft.com
SITE_ADDRESS=vynk.robustcraft.com
CERT_EMAIL=you@robustcraft.com

# Core secrets
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=
RABBITMQ_PASSWORD=

# Neon Postgres, database neondb, Vynk lives in the "plane" schema (OpenProject keeps using "public").
# Use the DIRECT endpoint (host WITHOUT "-pooler"): Neon's pooler rejects the search_path startup option.
# options=-c%20search_path%3Dplane is what points Django at the plane schema.
DATABASE_URL=postgresql://<user>:<password>@<ep-xxxx>.<region>.aws.neon.tech/neondb?sslmode=require&options=-c%20search_path%3Dplane

# AWS S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Email (needed for magic-link login)
EMAIL_FROM=Vynk <no-reply@robustcraft.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Slack bot (see integrations/slack-bot/README.md). PLANE_API_KEY comes from a workspace admin's
# Vynk profile -> Personal access tokens, so it can only be created after the first deploy.
PLANE_WORKSPACE_SLUG=
PLANE_API_KEY=
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
# Optional: BOT_TIMEZONE (Asia/Karachi), REMINDER_DAY (fri), REMINDER_TIME (17:00), REMINDER_MIN_HOURS (40)

# Optional AI (Groq): LLM_PROVIDER=groq, LLM_API_KEY=<Groq key, gsk_...>,
# LLM_MODEL=<optional, default llama-3.3-70b-versatile; any Groq model id works>.
# Other providers: openai | anthropic | gemini.
# NOTE: these only seed the settings the FIRST time an instance starts. Once saved, the values in the
# database win, so change them in the admin UI instead: /god-mode/ -> AI (Provider, Model, API key).
