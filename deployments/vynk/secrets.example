# Keys to create in Infisical (project env: prod, path: /). Values here are examples only.
# Generate random secrets with: openssl rand -hex 32   (use hex: special characters break the AMQP URL)

# Domain
APP_DOMAIN=vynk.robustcraft.com
WEB_URL=https://vynk.robustcraft.com
SITE_ADDRESS=vynk.robustcraft.com
CERT_EMAIL=you@robustcraft.com

# Core secrets
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=
RABBITMQ_PASSWORD=

# Supabase Postgres (direct or SESSION pooler, port 5432. NOT the 6543 transaction pooler)
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres?sslmode=require

# AWS S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Email (needed for magic-link login)
EMAIL_FROM=Vynk <no-reply@robustcraft.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Optional AI: LLM_PROVIDER (openai|anthropic|gemini), LLM_API_KEY, LLM_MODEL
