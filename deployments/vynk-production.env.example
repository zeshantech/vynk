# Vynk production settings template. Copy to your deployment's variables.env and fill every CHANGE_ME.
# Never commit real secrets.

# --- Domains ---
APP_DOMAIN=vynk.robustcraft.com
WEB_URL=https://vynk.robustcraft.com
APP_BASE_URL=https://vynk.robustcraft.com
# Admin (instance setup). Default is the /god-mode path on the main domain.
# To use the subdomain instead, set ADMIN_BASE_URL=https://admin.vynk.robustcraft.com and ADMIN_BASE_PATH="" (needs a proxy route, see notes).
ADMIN_BASE_URL=https://vynk.robustcraft.com
ADMIN_BASE_PATH=/god-mode
CORS_ALLOWED_ORIGINS=https://vynk.robustcraft.com,https://admin.vynk.robustcraft.com
SITE_ADDRESS=vynk.robustcraft.com
CERT_EMAIL=CHANGE_ME

# --- Secrets (generate: openssl rand -hex 32) ---
SECRET_KEY=CHANGE_ME
LIVE_SERVER_SECRET_KEY=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME

# --- File storage: AWS S3 (not MinIO) ---
USE_MINIO=0
AWS_REGION=CHANGE_ME
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_BUCKET_NAME=CHANGE_ME
# leave AWS_S3_ENDPOINT_URL unset for real AWS S3

# --- Email (magic-link login needs working SMTP) ---
EMAIL_FROM="Vynk <no-reply@robustcraft.com>"
EMAIL_HOST=CHANGE_ME
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=1

# --- Optional AI (provider: openai | anthropic | gemini) ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=CHANGE_ME
# LLM_MODEL=CHANGE_ME
