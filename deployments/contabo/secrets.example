# Keys to create in Infisical (project env: prod). Values here are examples only.
# Generate random secrets with: openssl rand -hex 32
# Use HEX for every password: they are embedded in URLs (Postgres, AMQP), so special characters break them.

# Domain (DNS A record must point at the Contabo IP before the first deploy, or TLS issuance fails)
APP_DOMAIN=vynk.robustcraft.com
WEB_URL=https://vynk.robustcraft.com
ACME_EMAIL=you@robustcraft.com

# Core secrets
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

# Postgres (runs in Docker on the server, data in the pgdata volume)
POSTGRES_USER=vynk
POSTGRES_DB=vynk
POSTGRES_PASSWORD=

# RabbitMQ (runs in Docker)
RABBITMQ_USER=vynk
RABBITMQ_VHOST=vynk
RABBITMQ_PASSWORD=

# AWS S3 (do NOT set AWS_S3_ENDPOINT_URL: that is only for MinIO)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Email (needed for magic-link login)
EMAIL_FROM=Vynk <no-reply@robustcraft.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Optional tuning: GUNICORN_WORKERS (2), PG_MAX_CONNECTIONS (200), DB_CONN_MAX_AGE (60), FILE_SIZE_LIMIT (5242880),
#                  TRUSTED_PROXIES (127.0.0.1/32; set Cloudflare ranges if you proxy through it)
# Optional AI: LLM_PROVIDER (openai|anthropic|gemini), LLM_API_KEY, LLM_MODEL
